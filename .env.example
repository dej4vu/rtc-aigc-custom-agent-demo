# RTC application credentials.
RTC_APP_ID=
RTC_APP_KEY=
RTC_BUSINESS_ID=

# Volcengine account credentials used to sign the MMPG WebSocket handshake
# and AibotxQuery. VOLC_ACCESS_KEY_ID / VOLC_SECRET_ACCESS_KEY are accepted
# as aliases for compatibility.
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
# VOLCENGINE_ACCESS_KEY_ID=
# VOLCENGINE_SECRET_ACCESS_KEY=

# Console-side conversational-AI bot. Its ASR/audio defaults are resolved
# with AibotxQuery; BotId itself is not an MMPG session field.
BOT_ID=
BOT_NAME=

# Streaming ASR credentials. Obtain these from the Doubao speech console.
# Speech API Key required by the current MMPG gateway schema.
ASR_API_KEY=
# Legacy AppId/AccessToken values are no longer sent by this demo.
ASR_APP_ID=
ASR_ACCESS_TOKEN=
# 1.0: volc.bigasr.sauc.duration；2.0: volc.seedasr.sauc.duration
# Leave empty to inherit the value from BOT_ID's AibotxQuery result.
ASR_RESOURCE_ID=
# Optional JSON string passed through as VolcanoASRParameters.
ASR_VOLCANO_PARAMS=

# Ark chat-completions configuration.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-character-260628
ARK_TEMPERATURE=0.3
ARK_MAX_TOKENS=512

# Doubao TTS. 3.0 uses the voice-specific JSONL streaming endpoint.
TTS_API_KEY=
TTS_API_VERSION=3.0
TTS_MODEL_ID=doubao-seed-tts-3.0
TTS_LANGUAGE_CODE=zh
TTS_SPEAKER=multi_female_sajiaoxuemei_v3_uranus_bigtts
TTS_SPEED=0.96
TTS_PITCH=1
TTS_INSTRUCTIONS=["甜软、亲密、轻声撒娇，表面温柔，藏着一点占有欲和危险感"]
TTS_SAMPLE_RATE=24000
TTS_FORMAT=pcm
# Only used when TTS_API_VERSION=2.0.
# TTS_RESOURCE_ID=seed-tts-2.0

# Runtime.
HOST=127.0.0.1
PORT=3101
# Production front-end build served at http://<host>:<port>/rtc-demo/
PUBLIC_DIR=server/public/build
MMPG_URL=wss://interactai.volcvideo.com/api/v2/mmpg
MMPG_REGION=cn-north-1
MMPG_SERVICE=rtc
LOG_TRANSCRIPTS=0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
